# Copie para .env e ajuste. NUNCA versione o arquivo .env.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://eventos.malucao.com.br

# Banco de dados (PostgreSQL em produção). Sem esta variável é usado SQLite local.
# DATABASE_URL=postgres://malucao:senha@localhost:5432/malucao

# Superusuário criado pelo comando setup_inicial (opcional)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=diretoria@exemplo.com
DJANGO_SUPERUSER_PASSWORD=troque-esta-senha

# Edição da JUV criada na configuração inicial
JUV_EDICAO=2026

# Backups
BACKUP_DIR=./backups
BACKUP_RETENCAO=14

# Produção atrás de HTTPS
# DJANGO_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=31536000
